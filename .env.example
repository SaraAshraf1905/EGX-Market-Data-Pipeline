# Copy to .env and fill in. NEVER commit .env.

# --- SQL Server (runs on your PC) ---
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=EGX_Warehouse
SQL_USER=egx_loader                   # login with WRITE access to gold/ops (used by load_merged.py)
SQL_PASSWORD=change_me
DBT_SQL_USER=dbt_user                 # login for dbt and the CSV export
DBT_SQL_PASSWORD=change_me

# --- MongoDB (runs on your PC) ---
MONGO_URI=mongodb://localhost:27017
MONGO_HOST=localhost
MONGO_PORT=27017
API_MONGO_DB=egx_raw_db
API_MONGO_COLLECTION=api_raw_responses
MONGO_DB=market_raw                   # Kafka consumer output
MONGO_COLLECTION=live_prices
MONGO_DEAD_LETTER_COLLECTION=live_prices_dead_letter

# --- Kafka (kafka-live-ingestion/docker-compose.yml) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=prod.yahoo.egx_prices.v1
KAFKA_CONSUMER_GROUP=mongo-writer
SYMBOLS_FILE=config/symbols.txt
CANDLE_INTERVAL=1d

# --- Paths (optional; defaults are inside the repo) ---
# SILVER_PATH=data/silver/fact_daily_price
# EXPORT_DIR=exports
