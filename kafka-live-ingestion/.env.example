# Copy this file to .env and edit it:   copy .env.example .env     (Windows)
# NEVER commit the real .env file (it is in .gitignore).

# --- Kafka ---------------------------------------------------------------
# Address used by Python scripts running on YOUR computer.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic name pattern: <env>.<source>.<data>.<version>
KAFKA_TOPIC=prod.yahoo.egx_prices.v1
# Consumer group of the script that writes to MongoDB.
KAFKA_CONSUMER_GROUP=mongo-writer

# --- MongoDB -------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=market_raw
MONGO_COLLECTION=live_prices
MONGO_DEAD_LETTER_COLLECTION=live_prices_dead_letter

# --- Producer behaviour --------------------------------------------------
SYMBOLS_FILE=config/symbols.txt
# Yahoo has NO intraday candles for EGX stocks, so we use daily candles (1d).
CANDLE_INTERVAL=1d
# Daily candles change slowly: check once an hour.
POLL_INTERVAL_SECONDS=3600
